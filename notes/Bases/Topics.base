filters:
  and:
    - file.tags.contains("Type/Topic")
formulas:
  Project Stage: Project.asFile().properties.Stage
properties:
  file.name:
    displayName: Topic
views:
  - type: table
    name: Table
    groupBy:
      property: Project
      direction: ASC
    order:
      - file.name
      - Description
      - Started
      - Completed
      - formula.Project Stage
    sort:
      - property: Project
        direction: ASC
    columnSize:
      note.Description: 569
      note.Completed: 117
  - type: table
    name: Projects View
    filters:
      or:
        - Project == this.file.name
    order:
      - file.name
      - Description
      - Started
      - Completed
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 302
      note.Description: 334
