filters:
  or:
    - tags.contains("Type/Project")
    - tags.contains("Type/Project/PoC")
    - tags.contains("Type/Project/Conference")
    - tags.contains("Type/Project/Internship")
    - tags.contains("Type/Project/Administration")
    - tags.contains("Type/Project/Project")
formulas:
  Project Name: link(file.name, file.name.split(" - ")[1])
properties:
  file.name:
    displayName: Project
views:
  - type: table
    name: Table
    order:
      - formula.Project Name
      - Client
      - Active
      - Stage
      - Start Date
      - End Date
      - Summary
      - Team
      - Manager
    sort:
      - column: formula.Project Name
        direction: ASC
      - column: file.name
        direction: ASC
      - column: note.Company
        direction: ASC
    columnSize:
      formula.Project Name: 235
      note.Stage: 184
      note.Start Date: 149
      note.End Date: 173
      note.Summary: 438
      note.Team: 725
  - type: table
    name: Client View
    filters:
      and:
        - Client == this.file.name
    order:
      - formula.Project Name
      - Active
      - Stage
      - Start Date
      - End Date
      - Summary
      - Team
      - Manager
    sort:
      - column: note.Company
        direction: ASC
    columnSize:
      note.Team: 801
  - type: table
    name: People View
    filters:
      or:
        - Team.contains(this.file.name)
        - Manager.contains(this.file.name)
    order:
      - Client
      - formula.Project Name
      - Active
      - Stage
      - Summary
      - Start Date
      - End Date
    sort:
      - column: note.Client
        direction: ASC
      - column: note.Company
        direction: ASC
    columnSize:
      note.Team: 801
  - type: table
    name: Active Projects
    filters:
      and:
        - Active == true
    order:
      - formula.Project Name
      - Client
      - Active
      - Stage
      - Start Date
      - End Date
      - Summary
      - Team
      - Manager
    sort:
      - column: formula.Project Name
        direction: ASC
      - column: file.name
        direction: ASC
      - column: note.Company
        direction: ASC
    columnSize:
      formula.Project Name: 235
      note.Stage: 153
      note.Summary: 626
      note.Team: 725
  - type: table
    name: Active Client Projects
    filters:
      and:
        - Active == true
        - Client != link("ELCA")
    order:
      - formula.Project Name
      - Client
      - Active
      - Stage
      - Start Date
      - End Date
      - Summary
      - Manager
      - Team
    sort:
      - column: note.Stage
        direction: DESC
      - column: formula.Project Name
        direction: DESC
      - column: note.Manager
        direction: ASC
      - column: file.name
        direction: ASC
      - column: note.Company
        direction: ASC
    columnSize:
      formula.Project Name: 235
      note.Stage: 153
      note.Start Date: 139
      note.End Date: 173
      note.Summary: 474
      note.Team: 725
