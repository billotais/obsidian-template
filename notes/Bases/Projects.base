summaries:
  Count: values.unique().length
  Unique: values.unique().length
  new summary: ""
filters:
  or:
    - file.tags.contains("Type/Project")
formulas:
  Project Name: link(file.name, file.name.split(" - ")[1])
  Untitled: ""
properties:
  file.name:
    displayName: Project
views:
  - type: table
    name: Table
    groupBy:
      property: Stage
      direction: ASC
    order:
      - Client
      - formula.Project Name
      - Active
      - Stage
      - Start Date
      - End Date
      - Summary
      - Team
      - Manager
      - Client Partner
    sort:
      - property: Client
        direction: ASC
      - property: formula.Project Name
        direction: ASC
    summaries: {}
    columnSize:
      formula.Project Name: 235
      note.Stage: 184
      note.Start Date: 149
      note.End Date: 173
      note.Summary: 438
      note.Team: 479
  - type: table
    name: Client View
    filters:
      and:
        - Client == this.file.name
    groupBy:
      property: Stage
      direction: ASC
    order:
      - formula.Project Name
      - Active
      - Stage
      - Start Date
      - End Date
      - Summary
      - Team
      - Manager
    sort:
      - property: Company
        direction: ASC
    columnSize:
      note.Stage: 115
      note.Team: 801
  - type: table
    name: People View
    filters:
      or:
        - Team.contains(this.file.name)
        - Manager.contains(this.file.name)
    groupBy:
      property: Stage
      direction: ASC
    order:
      - Client
      - formula.Project Name
      - Active
      - Stage
      - Summary
      - Start Date
      - End Date
      - Team
    sort:
      - property: Summary
        direction: DESC
      - property: Team
        direction: ASC
      - property: End Date
        direction: ASC
      - property: formula.Untitled
        direction: DESC
      - property: Client
        direction: ASC
      - property: Company
        direction: ASC
    columnSize:
      formula.Project Name: 195
      note.Stage: 171
      note.Summary: 371
      note.Start Date: 146
  - type: table
    name: Active Projects
    filters:
      and:
        - Active == true
    order:
      - formula.Project Name
      - Client
      - Active
      - Stage
      - Start Date
      - End Date
      - Summary
      - Team
      - Manager
    sort:
      - property: formula.Project Name
        direction: DESC
      - property: Start Date
        direction: DESC
      - property: file.name
        direction: ASC
      - property: Company
        direction: ASC
    columnSize:
      formula.Project Name: 235
      note.Stage: 153
      note.Summary: 626
      note.Team: 725
  - type: table
    name: Active Client Projects
    filters:
      and:
        - Active == true
        - Client != link("ELCA")
    order:
      - formula.Project Name
      - Client
      - Active
      - Stage
      - Start Date
      - End Date
      - Summary
      - Manager
      - Team
    sort:
      - property: Stage
        direction: DESC
      - property: formula.Project Name
        direction: DESC
      - property: Manager
        direction: ASC
      - property: file.name
        direction: ASC
      - property: Company
        direction: ASC
    columnSize:
      formula.Project Name: 235
      note.Stage: 153
      note.Start Date: 139
      note.End Date: 173
      note.Summary: 474
      note.Team: 725
  - type: table
    name: Ongoing Projects
    filters:
      and:
        - Stage == "40. Ongoing"
    order:
      - formula.Project Name
      - Client
      - Active
      - Stage
      - Start Date
      - End Date
      - Summary
      - Team
      - Manager
    sort:
      - property: formula.Project Name
        direction: DESC
      - property: Start Date
        direction: DESC
      - property: file.name
        direction: ASC
      - property: Company
        direction: ASC
    columnSize:
      formula.Project Name: 235
      note.Stage: 153
      note.Summary: 626
      note.Team: 725
  - type: table
    name: 2025 Projects
    filters:
      or:
        - Active == true
        - note["End Date"] > "2025-01-01"
    groupBy:
      property: Stage
      direction: ASC
    order:
      - formula.Project Name
      - Client
      - Active
      - Stage
      - Start Date
      - End Date
      - Summary
      - Team
      - Manager
    sort:
      - property: formula.Project Name
        direction: DESC
      - property: Start Date
        direction: DESC
      - property: file.name
        direction: ASC
      - property: Company
        direction: ASC
    columnSize:
      formula.Project Name: 235
      note.Stage: 153
      note.Summary: 626
      note.Team: 725
  - type: table
    name: Concept View
    filters:
      and:
        - file.links.contains(this.file)
    order:
      - formula.Project Name
      - Client
      - Active
      - Stage
      - Summary
    sort:
      - property: Company
        direction: ASC
    columnSize:
      note.Active: 95
      note.Stage: 235
      note.Summary: 278
