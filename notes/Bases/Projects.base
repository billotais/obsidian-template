filters:
  or:
    - tags.contains("Type/Project")
    - tags.contains("Type/Project/PoC")
    - tags.contains("Type/Project/Conference")
    - tags.contains("Type/Project/Internship")
    - tags.contains("Type/Project/Administration")
    - tags.contains("Type/Project/Project")
formulas:
  Project Name: link(file.name, file.name.split(" - ")[1])
properties:
  file.name:
    displayName: Project
views:
  - type: table
    name: Table
    order:
      - formula.Project Name
      - Client
      - Active
      - Team
      - Manager
    sort:
      - column: formula.Project Name
        direction: ASC
      - column: file.name
        direction: ASC
      - column: note.Company
        direction: ASC
    columnSize:
      formula.Project Name: 235
      note.Team: 725
  - type: table
    name: Client View
    filters:
      and:
        - Client == this.file.name
    order:
      - formula.Project Name
      - Active
      - Team
      - Manager
    sort:
      - column: note.Company
        direction: ASC
    columnSize:
      note.Team: 801
  - type: table
    name: People View
    filters:
      or:
        - Team.contains(this.file.name)
        - Manager.contains(this.file.name)
    order:
      - Client
      - formula.Project Name
      - Active
    sort:
      - column: note.Client
        direction: ASC
      - column: note.Company
        direction: ASC
    columnSize:
      note.Team: 801
  - type: table
    name: Active Projects
    filters:
      and:
        - Active == true
    order:
      - formula.Project Name
      - Client
      - Active
      - Team
      - Manager
    sort:
      - column: formula.Project Name
        direction: ASC
      - column: file.name
        direction: ASC
      - column: note.Company
        direction: ASC
    columnSize:
      formula.Project Name: 235
      note.Team: 725
