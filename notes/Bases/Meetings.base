filters:
  or:
    - tags.contains("Type/Meeting/Interview")
    - tags.contains("Type/Meeting/Catchup")
    - tags.contains("Type/Meeting/Group")
formulas:
  simple_name: link(file.name, file.name.split(" - ")[0])
properties:
  file.name:
    displayName: Meeting
  formula.simple_name:
    displayName: Meeting Name
views:
  - type: table
    name: Table
    order:
      - formula.simple_name
      - Date
      - Project
      - Participants
    columnSize:
      formula.simple_name: 217
      note.Participants: 834
    sort:
      - column: note.Date
        direction: DESC
  - type: table
    name: People View
    filters:
      or:
        - Participants.contains(this.file.name)
    order:
      - Project
      - formula.simple_name
      - Date
    columnSize:
      formula.simple_name: 165
    sort:
      - column: note.Project
        direction: ASC
  - type: table
    name: Projects View
    filters:
      or:
        - Project == this.file.name
    order:
      - formula.simple_name
      - Date
      - Participants
    columnSize:
      note.Participants: 1009
    sort:
      - column: note.Date
        direction: DESC
      - column: note.Participants
        direction: ASC
      - column: note.Project
        direction: ASC
  - type: table
    name: Topics View
    filters:
      or:
        - Topics.contains(this.file.name)
    order:
      - formula.simple_name
      - Date
      - Participants
    columnSize:
      note.Participants: 1009
    sort:
      - column: note.Date
        direction: ASC
      - column: note.Participants
        direction: ASC
      - column: note.Project
        direction: ASC
  - type: table
    name: Daily View
    filters:
      and:
        - Date == this.Date
    order:
      - formula.simple_name
      - Project
      - Participants
    sort:
      - column: note.Project
        direction: ASC
    columnSize:
      file.name: 408
      note.Project: 255
