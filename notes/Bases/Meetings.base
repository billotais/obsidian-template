filters:
  or:
    - file.tags.contains("Type/Meeting")
formulas:
  simple_name: link(file.name, note["Meeting Name"])
properties:
  file.name:
    displayName: Meeting
  formula.simple_name:
    displayName: Meeting Name
views:
  - type: table
    name: Latest 100
    groupBy:
      property: Project
      direction: ASC
    order:
      - formula.simple_name
      - Date
      - Project
      - Participants
    sort:
      - property: Date
        direction: DESC
    limit: 100
    columnSize:
      formula.simple_name: 331
      note.Date: 217
      note.Participants: 834
  - type: table
    name: People View
    filters:
      or:
        - Participants.contains(this.file.name)
    groupBy:
      property: Project
      direction: ASC
    order:
      - formula.simple_name
      - Date
      - file
    sort:
      - property: Date
        direction: DESC
      - property: Project
        direction: ASC
    columnSize:
      formula.simple_name: 187
  - type: table
    name: Projects View
    filters:
      or:
        - Project == this.file.name
    groupBy:
      property: Topics
      direction: ASC
    order:
      - formula.simple_name
      - Date
      - Participants
    sort:
      - property: Date
        direction: DESC
      - property: Meeting Name
        direction: ASC
    columnSize:
      formula.simple_name: 382
      note.Date: 152
      note.Participants: 515
  - type: table
    name: Topics View
    filters:
      or:
        - Topics.contains(this.file.name)
    order:
      - formula.simple_name
      - Date
      - Participants
    sort:
      - property: Date
        direction: ASC
    columnSize:
      note.Participants: 1009
  - type: table
    name: Daily View
    filters:
      and:
        - Date == this.Date
    groupBy:
      property: Project
      direction: ASC
    order:
      - formula.simple_name
      - Date
      - Participants
    sort:
      - property: Project
        direction: DESC
      - property: formula.simple_name
        direction: DESC
    columnSize:
      note.Date: 154
      note.Participants: 823
  - type: table
    name: Topic View
    filters:
      and:
        - file.links.contains(this.file)
    order:
      - file
      - Date
      - Project
      - Participants
    sort:
      - property: Date
        direction: DESC
    limit: 100
    columnSize:
      note.Date: 194
      note.Participants: 834
  - type: table
    name: Concept View
    filters:
      and:
        - file.links.contains(this.file)
    order:
      - file
      - Date
      - Project
      - Participants
    sort:
      - property: Date
        direction: DESC
    limit: 100
    columnSize:
      note.Date: 194
      note.Participants: 834
