filters:
  or:
    - tags.contains("Type/Note/Topic")
formulas:
  Note Name: link(file.name, file.name.split(" - ")[1])
properties:
  file.name:
    displayName: Note
views:
  - type: table
    name: Table
    order:
      - Project
      - formula.Note Name
      - Date
    sort:
      - column: note.Date
        direction: ASC
    columnSize:
      note.Project: 282
      formula.Note Name: 477
  - type: table
    name: Projects View
    filters:
      or:
        - Project == this.file.name
    order:
      - formula.Note Name
      - Date
      - Topics
    sort:
      - column: note.Date
        direction: DESC
      - column: note.Project
        direction: DESC
  - type: table
    name: Topics View
    filters:
      or:
        - Topics.contains(this.file.name)
    order:
      - formula.Note Name
      - Date
    sort:
      - column: note.Date
        direction: DESC
      - column: note.Project
        direction: DESC
  - type: table
    name: People View
    filters:
      or:
        - file.hasLink(this.file.name)
    order:
      - Project
      - formula.Note Name
      - Date
    sort:
      - column: note.Project
        direction: ASC
      - column: note.Date
        direction: ASC
