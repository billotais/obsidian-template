filters:
  or:
    - file.tags.contains("Type/Note/Topic")
formulas:
  Note Name: link(file.name, file.name.split(" - ")[1])
properties:
  file.name:
    displayName: Note
views:
  - type: table
    name: Latest 100
    groupBy:
      property: Project
      direction: ASC
    order:
      - formula.Note Name
      - Topics
      - Date
      - Summary
      - Note Name
    sort:
      - property: Date
        direction: DESC
    limit: 100
    columnSize:
      formula.Note Name: 355
      note.Date: 179
      note.Summary: 478
  - type: table
    name: Projects View
    filters:
      or:
        - Project == this.file.name
    groupBy:
      property: Topics
      direction: ASC
    order:
      - formula.Note Name
      - Date
      - Summary
    sort:
      - property: Date
        direction: DESC
      - property: Summary
        direction: ASC
      - property: Project
        direction: DESC
    columnSize:
      formula.Note Name: 311
      note.Date: 174
      note.Summary: 441
  - type: table
    name: Topics View
    filters:
      or:
        - Topics.contains(this.file.name)
    order:
      - formula.Note Name
      - Date
      - Summary
    sort:
      - property: Date
        direction: DESC
      - property: Project
        direction: DESC
    columnSize:
      formula.Note Name: 328
  - type: table
    name: People View
    filters:
      or:
        - file.hasLink(this.file.name)
    order:
      - Project
      - formula.Note Name
      - Date
      - Summary
    sort:
      - property: Project
        direction: ASC
      - property: Date
        direction: ASC
    columnSize:
      formula.Note Name: 325
      note.Date: 186
  - type: table
    name: Modified Today
    filters:
      and:
        - file.mtime == this.date
    groupBy:
      property: Project
      direction: ASC
    order:
      - formula.Note Name
      - Date
      - Summary
    sort:
      - property: Date
        direction: ASC
    columnSize:
      note.Project: 343
      formula.Note Name: 250
      note.Date: 240
      note.Summary: 359
  - type: table
    name: Concept View
    filters:
      and:
        - file.links.contains(this.file)
    order:
      - file.name
      - Project
    columnSize:
      file.name: 312
