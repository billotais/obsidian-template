filters:
  and:
    - file.tags.contains("Type/Note/Task")
formulas:
  Task: link(file, Task)
views:
  - type: table
    name: Table
    order:
      - Project
      - formula.Task
      - Priority
      - Created On
      - Due On
      - Started
      - Completed
    sort: []
    columnSize:
      formula.Task: 190
      note.Created On: 154
      note.Due On: 147
  - type: table
    name: Project View
    filters:
      and:
        - Project == this.file
        - Completed != true
    order:
      - formula.Task
      - Priority
      - Created On
      - Due On
      - Started
      - Completed
    sort: []
    columnSize:
      note.Created On: 173
      note.Due On: 190
  - type: table
    name: Overdue
    filters:
      and:
        - note["Due On"] < today()
    order:
      - Project
      - formula.Task
      - Priority
      - Created On
      - Due On
      - Started
      - Completed
    sort: []
    columnSize:
      note.Created On: 172
      note.Due On: 172
  - type: table
    name: Due next 7 days
    filters:
      and:
        - note["Due On"] <= today() + "7 days"
        - note["Due On"] >= today()
    order:
      - Project
      - formula.Task
      - Priority
      - Created On
      - Due On
      - Started
      - Completed
    sort: []
    columnSize:
      note.Created On: 173
      note.Due On: 171
