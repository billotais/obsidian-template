filters:
  and:
    - tags.contains("Type/Person")
properties:
  file.name:
    displayName: Person
views:
  - type: table
    name: Table
    order:
      - file.name
      - Company
      - Role
    columnSize:
      note.Role: 395
    sort:
      - column: note.Company
        direction: ASC
      - column: file.name
        direction: ASC
      - column: note.Role
        direction: ASC
  - type: table
    name: Company View
    filters:
      and:
        - Company == this.file.name
    order:
      - file.name
      - Role
    sort: []
    columnSize:
      file.name: 182
      note.Role: 371
