filters:
  and:
    - file.tags.contains("Type/Person")
properties:
  file.name:
    displayName: Person
views:
  - type: table
    name: Table
    groupBy:
      property: Company
      direction: ASC
    order:
      - file.name
      - Division
      - Role
      - Departed
      - Hierarchy
    sort:
      - property: Division
        direction: ASC
    columnSize:
      file.name: 238
      note.Role: 395
      note.Departed: 173
  - type: table
    name: Company View
    filters:
      and:
        - Company == this.file.name
        - Departed != true
    groupBy:
      property: Division
      direction: ASC
    order:
      - file.name
      - Division
      - Departed
      - Role
    sort:
      - property: file.name
        direction: ASC
      - property: Departed
        direction: ASC
    columnSize:
      file.name: 268
      note.Role: 371
