filters:
  and:
    - tags.contains("Type/Person")
properties:
  file.name:
    displayName: Person
views:
  - type: table
    name: Table
    order:
      - file.name
      - Division
      - Company
      - Role
      - Departed
    columnSize:
      note.Team: 132
      note.Role: 395
    sort:
      - column: note.Company
        direction: ASC
      - column: file.name
        direction: ASC
      - column: note.Role
        direction: ASC
  - type: table
    name: Company View
    filters:
      and:
        - Company == this.file.name
    order:
      - file.name
      - Division
      - Departed
      - Role
    sort:
      - column: file.name
        direction: ASC
      - column: note.Departed
        direction: ASC
    columnSize:
      file.name: 182
      note.Role: 371
  - type: table
    name: ELCA
    filters:
      and:
        - Company == "ELCA"
    order:
      - file.name
      - Company
      - Division
      - Role
      - Departed
    columnSize:
      note.Team: 132
      note.Role: 395
    sort:
      - column: note.Company
        direction: ASC
      - column: file.name
        direction: ASC
      - column: note.Role
        direction: ASC
  - type: table
    name: Clients
    filters:
      and:
        - Company != link("ELCA")
    order:
      - file.name
      - Company
      - Division
      - Role
      - Departed
    columnSize:
      note.Team: 132
      note.Role: 395
    sort:
      - column: note.Company
        direction: ASC
      - column: file.name
        direction: ASC
      - column: note.Role
        direction: ASC
